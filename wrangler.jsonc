{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oneapi-workers",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // 管理员令牌：生产用 `wrangler secret put ADMIN_KEY` 配成加密 Secret（不要提交到仓库）；
    // 本地开发写 .dev.vars（已被 gitignore）。没有配置时管理面返回 503 而不是敞开。
    // 可选：路由缺口告警冷却（分钟），默认 30。
    // "WECOM_HEALTH_ALERT_COOLDOWN_MIN": "30"
  },
  // Secret（不要写进这里）：
  //   WECOM_WEBHOOK_URL         账本自检告警（lib/watchdog.ts）
  //   WECOM_HEALTH_WEBHOOK_URL  路由缺口 503 告警 + 恢复通知（lib/route-alert.ts）
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oneapi",
      "database_id": "4527d8b4-b712-4627-804d-8dba37572112"
    }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "0cb8a1d723494ac68d923550ff18981c" }
  ],
  // 两个定时任务：0 19 * * * 账本自检；*/5 * * * * 退回无人认领的中继预扣 + 路由缺口恢复。
  // 后者必须和 lib/watchdog.ts 的 SWEEP_CRON 一模一样。
  "triggers": {
    "crons": ["0 19 * * *", "*/5 * * * *"]
  }
  // 自定义域按需配置（公开仓库不暴露线上域名）：
  // "routes": [{ "pattern": "你的域名", "custom_domain": true }]
}